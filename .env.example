# Copie para backend/.env e ajuste.
FINFAM_ENV=development            # production exige SECRET_KEY
# Use a MESMA SECRET_KEY do FinFam antigo se for reaproveitar o gastos.db:
# os tokens do Telegram estão criptografados com ela.
SECRET_KEY=
# DATABASE_URL=sqlite:///C:/caminho/gastos.db   # padrão: backend/instance/gastos.db
ACCESS_TOKEN_MINUTES=10080        # validade do login (7 dias)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_EMAIL=admin@finfam.app
ADMIN_INITIAL_PASSWORD=           # só usada ao criar o admin pela primeira vez
SCHEDULER_ENABLED=1               # lembrete diário do Telegram
INSECURE_EXTERNAL_SSL=0           # 1 só em Raspberry Pi com certificados antigos
TRIAL_DAYS=90
RATE_LIMIT_ENABLED=1              # limite de tentativas de login/cadastro
