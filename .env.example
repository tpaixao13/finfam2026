# Copie para backend/.env e ajuste.
# Comentários SEMPRE em linha própria (o systemd não aceita comentário no fim da linha).

# development | production (production exige SECRET_KEY)
FINFAM_ENV=development

# Use a MESMA SECRET_KEY do FinFam antigo se for reaproveitar o gastos.db
# (os tokens do Telegram estão criptografados com ela).
SECRET_KEY=

# Padrão: backend/instance/gastos.db
# DATABASE_URL=sqlite:////home/finfam/finfam2026/backend/instance/gastos.db

# Validade do login em minutos (7 dias)
ACCESS_TOKEN_MINUTES=10080

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ADMIN_EMAIL=admin@finfam.app
# Só usada ao criar o admin pela primeira vez
ADMIN_INITIAL_PASSWORD=

# Lembrete diário do Telegram (1 = ligado)
SCHEDULER_ENABLED=1

# 1 só em Raspberry Pi com certificados antigos
INSECURE_EXTERNAL_SSL=0

TRIAL_DAYS=90

# Pasta de uploads do FinFam antigo (só leitura): as fotos de perfil são copiadas
# para o FinFam 2026 ao subir a API. Ex. no Raspberry:
# LEGACY_UPLOAD_DIR=/home/finfam/Documents/Controledegastos/app/static/uploads
LEGACY_UPLOAD_DIR=

# Limite de tentativas de login/cadastro (1 = ligado)
RATE_LIMIT_ENABLED=1

# ── Bot central do Telegram (opcional) ──
# Token do bot criado no @BotFather (um bot para todas as famílias)
TELEGRAM_BOT_TOKEN=
# Nome do bot, sem @ (ex.: FinFamBot)
TELEGRAM_BOT_USERNAME=
# Senha interna entre o bot e a API (mínimo 32 caracteres variados). Só vale em
# chamadas feitas no próprio servidor (127.0.0.1), nunca pela internet. Gere com:
# python3 -c "import secrets; print(secrets.token_urlsafe(40))"
BOT_API_KEY=
# Endereço do site, mostrado pelo bot para quem ainda não conectou
FINFAM_SITE_URL=

# ── Backup diário do banco pelo Telegram (scripts.backup_telegram, via cron) ──
# Seu chat PRIVADO com o bot (o arquivo tem os dados de todas as famílias).
BACKUP_CHAT_ID=
# Grupo (id começa com -) só com BACKUP_ALLOW_GROUP=1 — o backup tem os dados de TODAS as famílias.
BACKUP_ALLOW_GROUP=0
# Opcional: outro bot só para backup (padrão: TELEGRAM_BOT_TOKEN)
BACKUP_BOT_TOKEN=

# ── Open Finance (Pluggy) — versão 2026.2.0 ──
# Endereço público do site (https), usado no webhook que a Pluggy chama
PUBLIC_URL=https://finfam.net.br
# IPs de onde a Pluggy envia os webhooks (separados por vírgula; vazio = não confere)
PLUGGY_WEBHOOK_IPS=52.67.145.81
# Mostra os bancos de teste (sandbox) da Pluggy no Connect. Use 0 quando for só bancos reais.
PLUGGY_INCLUDE_SANDBOX=1

# ── E-mail (boas-vindas com confirmação e "esqueci minha senha") ─────────────────
# Sem SMTP_HOST o e-mail fica desligado: a conta nova já entra sem confirmar e "esqueci a senha" não funciona.
# Locaweb (e-mail do domínio): servidor email-ssl.com.br, porta 465 com SSL; usuário = o e-mail completo.
# Os links dos e-mails usam o PUBLIC_URL acima (ex.: https://finfam2026.finfam.net.br).
# Teste: .venv/bin/python -m scripts.test_email voce@exemplo.com
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=noreply@finfam.net.br
SMTP_PASSWORD=
SMTP_FROM=FinFam <noreply@finfam.net.br>
