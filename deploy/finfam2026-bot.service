# systemd — bot central do FinFam no Telegram (um bot para todas as famílias).
# Usa long polling: não precisa abrir porta nem mexer no cloudflared.
# Instalar: sudo cp deploy/finfam2026-bot.service /etc/systemd/system/ && sudo systemctl enable --now finfam2026-bot
[Unit]
Description=FinFam 2026 - bot do Telegram
After=finfam2026.service network-online.target
Wants=network-online.target

[Service]
User=finfam
WorkingDirectory=/home/finfam/finfam2026/bot
EnvironmentFile=/home/finfam/finfam2026/backend/.env
Environment=FINFAM_API_URL=http://127.0.0.1:8001/api/v1
ExecStart=/home/finfam/finfam2026/backend/.venv/bin/python -m finfam_bot
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
