# Copie para backend/.env e ajuste.
# Comentários SEMPRE em linha própria (o systemd não aceita comentário no fim da linha).

# development | production (production exige SECRET_KEY)
FINFAM_ENV=development

# Use a MESMA SECRET_KEY do FinFam antigo se for reaproveitar o gastos.db
# (os tokens do Telegram estão criptografados com ela).
SECRET_KEY=

# Padrão: backend/instance/gastos.db
# DATABASE_URL=sqlite:////home/finfam/finfam2026/backend/instance/gastos.db

# Validade do login em minutos (7 dias)
ACCESS_TOKEN_MINUTES=10080

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ADMIN_EMAIL=admin@finfam.app
# Só usada ao criar o admin pela primeira vez
ADMIN_INITIAL_PASSWORD=

# Lembrete diário do Telegram (1 = ligado)
SCHEDULER_ENABLED=1

# 1 só em Raspberry Pi com certificados antigos
INSECURE_EXTERNAL_SSL=0

TRIAL_DAYS=90

# Limite de tentativas de login/cadastro (1 = ligado)
RATE_LIMIT_ENABLED=1
